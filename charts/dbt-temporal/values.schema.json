{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "dbt-temporal chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "variant": {
          "type": "string",
          "enum": [
            "",
            "distroless"
          ]
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string",
          "description": "Temporal frontend host:port. Required."
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "taskQueue": {
          "type": "string",
          "minLength": 1
        },
        "deploymentName": {
          "type": "string"
        },
        "apiKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        }
      }
    },
    "dbt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectDirs": {
          "type": "string",
          "description": "Comma-separated project sources. Required."
        },
        "target": {
          "type": "string"
        },
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "inline": {
              "type": "string"
            }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingSecret": {
                  "type": "string"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "username": {
              "type": "string",
              "description": "Sent with the token; empty sends the token as the username."
            },
            "ssh": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingSecret": {
                  "type": "string",
                  "description": "Secret with ssh-privatekey and known_hosts keys."
                }
              }
            },
            "caBundle": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "configMap": {
                  "type": "string"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "store": {
          "type": "string"
        },
        "catalog": {
          "type": "boolean"
        },
        "runLog": {
          "type": "boolean"
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gracefulShutdownSeconds": {
          "type": [
            "integer",
            "null",
            "string"
          ],
          "pattern": "^$|^[0-9]+$",
          "minimum": 0
        },
        "terminationGraceBufferSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "terminationGracePeriodSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tuning": {
          "type": "object",
          "propertyNames": {
            "pattern": "^WORKER_[A-Z0-9_]+$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "startupProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "livenessProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "annotations": {
              "type": "object"
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          }
        }
      }
    },
    "keda": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxReplicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "pollingInterval": {
          "type": "integer",
          "minimum": 1
        },
        "cooldownPeriod": {
          "type": "integer",
          "minimum": 0
        },
        "targetQueueSize": {
          "type": [
            "string",
            "integer"
          ]
        },
        "activationTargetQueueSize": {
          "type": [
            "string",
            "integer"
          ]
        },
        "queueTypes": {
          "type": "string",
          "pattern": "^(workflow|activity)(,(workflow|activity))?$"
        },
        "useTemporalApiKey": {
          "type": "boolean"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "envFrom": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "tmp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "medium": {
          "type": "string",
          "enum": [
            "",
            "Memory"
          ]
        },
        "sizeLimit": {
          "type": "string"
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeLimit": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    }
  }
}
