# Distroless variant of the release image: the same prebuilt glibc binary as
# docker/Dockerfile.release, on gcr.io/distroless/cc-debian12 — no shell, no
# package manager, minimal attack surface. Still glibc (the cc image ships
# libc/libssl/libgcc + ca-certificates), so the CDN ADBC drivers dbt dlopens at
# runtime load correctly.
#
# Trade-off vs the debian-slim image: smaller and harder to tamper with, but no
# shell for `kubectl exec` debugging, and no `git` — so `git+https://` /
# `git+ssh://` project sources do not work here. Bake the project into a
# derived image, mount it, or fetch it from `gs://` / `s3://` instead.
FROM gcr.io/distroless/cc-debian12 AS base

# libpq for dbt's Postgres driver, which the cc image lacks: staged from the
# Debian release distroless is built from, minus what the base already has.
FROM debian:bookworm-slim AS libpq
COPY --from=base / /base
COPY docker/stage-libpq.sh /usr/local/bin/
RUN stage-libpq.sh /base /staged

FROM base
COPY --from=libpq /staged/ /

# One prebuilt binary per platform, at bin/dbt-temporal-linux-<arch>/ (see the
# release workflow); buildx sets TARGETARCH for each platform it builds. Upload
# artifacts drop the executable bit, hence --chmod.
ARG TARGETARCH
COPY --chmod=0755 bin/dbt-temporal-linux-${TARGETARCH}/dbt-temporal /usr/local/bin/dbt-temporal

# Distributing the image distributes the binary, so its license and the
# texts of everything compiled into it travel with it. The release workflow
# generates target/licenses/ with `make licenses` before building.
COPY LICENSE target/licenses/THIRD-PARTY-LICENSES.txt /usr/share/doc/dbt-temporal/

ENTRYPOINT ["dbt-temporal"]
