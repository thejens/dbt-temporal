# Release runtime image built from the prebuilt glibc binary produced by the
# `deb` job in .github/workflows/release.yml — the binary is compiled once and
# copied in, not rebuilt here. (docker/Dockerfile still builds from source and
# is what the CI docker-build check uses.)
#
# Debian slim keeps glibc so the ADBC warehouse drivers dbt dlopens at runtime
# — the glibc builds shipped from the dbt CDN — load correctly. The binary is
# built on debian:12 (same glibc as bookworm-slim), so it runs here unchanged.
#
# `git` (and `openssh-client` for `git+ssh://`) are runtime dependencies, not
# conveniences: `git+https://` / `git+ssh://` entries in DBT_PROJECT_DIRS are
# fetched by shelling out to the git CLI at startup.
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 git openssh-client \
    && rm -rf /var/lib/apt/lists/*

# A passwd entry for the non-root UID that Kubernetes deployments (and the Helm
# chart) run as, matching distroless's `nonroot`. OpenSSH resolves the user with
# getpwuid() and refuses to start without one, so `git+ssh://` sources would
# fail before connecting. Home is /tmp: the one path writable under a
# read-only root filesystem.
RUN groupadd --gid 65532 nonroot \
    && useradd --uid 65532 --gid 65532 --home-dir /tmp --no-create-home \
    --shell /usr/sbin/nologin nonroot

COPY dbt-temporal /usr/local/bin/dbt-temporal

ENTRYPOINT ["dbt-temporal"]
